<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Debug builds also trust user-installed CAs so an operator can use mkcert.
        Certificate chain and hostname verification stay enabled. Cleartext stays disabled.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
