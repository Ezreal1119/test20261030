<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POD camera test"
            android:textColor="@color/navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="Camera"
            android:textColor="@color/navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/podCameraRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.camera.view.PreviewView
            android:id="@+id/podPreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/buttonPodCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CAPTURE &amp; MEASURE" />

        <ImageView
            android:id="@+id/imagePodThumb"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Last saved capture"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Last capture"
            android:textColor="@color/navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/podLastRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingTop="16dp"
            android:text="Legibility is your visual check of the manual sample. Open the image and zoom in before choosing. Resolution does not decide this."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonLegibilityPass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LEGIBILITY PASS" />

            <Button
                android:id="@+id/buttonLegibilityFail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LEGIBILITY FAIL" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonLegibilityClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LEGIBILITY NOT REVIEWED" />

        <Button
            android:id="@+id/buttonPodView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="VIEW IMAGE" />

        <Button
            android:id="@+id/buttonPodBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RUN 30 CAPTURES" />

        <Button
            android:id="@+id/buttonPodCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL 30 CAPTURES" />

        <Button
            android:id="@+id/buttonPodSpec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRM 13 MP SPEC" />

        <Button
            android:id="@+id/buttonPodCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPORT CSV" />

        <Button
            android:id="@+id/buttonPodJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPORT JSON" />

        <Button
            android:id="@+id/buttonPodShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE SAMPLE IMAGE" />

        <Button
            android:id="@+id/buttonPodClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR RESULTS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Summary"
            android:textColor="@color/navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPodOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="NOT TESTED"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPodNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingTop="8dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/podSummaryRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
