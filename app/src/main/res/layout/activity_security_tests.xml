<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/securityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Negative security tests"
        android:textColor="@color/navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Device checks use this handset and the live API. The server suite uses the same verification functions with locally generated keys. Neither list is simulated."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDeviceChecks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run device-side checks" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonServerSuite"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run server verifier suite" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textSecurityResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="NOT TESTED\nNo negative tests have been run from this screen."
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>
</LinearLayout>
