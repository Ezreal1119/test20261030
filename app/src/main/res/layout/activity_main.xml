<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="DT610 Pro authentication verification"
            android:textColor="@color/navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Reference implementation for device-bound authentication and phishing-resistant MFA. Results are recorded only after the backend verifies them."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Connection" />

                <TextView
                    android:id="@+id/textAssetHost"
                    style="@style/BodyText"
                    android:textColor="@color/muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Backend HTTPS URL"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Lab admin token"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editAdminToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Username"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Enrollment token"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEnrollmentToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/textRegistrationId"
                    style="@style/BodyText"
                    android:layout_marginTop="8dp"
                    android:text="Registration ID: not registered" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCheckBackend"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check backend" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonShowFingerprint"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show signing certificate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPublishFingerprint"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Publish fingerprint to backend" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonIssueToken"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Issue enrollment token" />

                <TextView
                    android:id="@+id/textSettingsStatus"
                    style="@style/BodyText"
                    android:text="NOT TESTED\nSettings have not been checked against the backend." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Device information" />

                <TextView
                    android:id="@+id/textDeviceInfo"
                    style="@style/BodyText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Device authentication" />

                <TextView
                    android:id="@+id/textDeviceStatus"
                    style="@style/BodyText"
                    android:text="NOT TESTED\nGenerate a key, inspect it, then register and authenticate." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGenerateKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Generate Device Key" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonInspectKey"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inspect Key Security" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRegisterDevice"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register Device" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonTestDeviceAuth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Device Authentication" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="WebAuthn authentication" />

                <TextView
                    style="@style/BodyText"
                    android:text="@string/passkey_explanation" />

                <TextView
                    android:id="@+id/textWebauthnStatus"
                    style="@style/BodyText"
                    android:text="NOT TESTED\nRegister a Passkey, then authenticate." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRegisterPasskey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register Passkey" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAuthenticatePasskey"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Authenticate with Passkey" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonViewCredential"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Credential Properties" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Integrated authentication" />

                <TextView
                    style="@style/BodyText"
                    android:text="@string/integrated_explanation" />

                <TextView
                    android:id="@+id/textIntegratedStatus"
                    style="@style/BodyText"
                    android:text="NOT TESTED\nNo complete authentication has been measured in this session." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Complete Authentication" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonViewHistory"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Authentication History" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Security testing" />

                <TextView
                    style="@style/BodyText"
                    android:text="Device-side checks call the live verifier. WebAuthn, expiry, and session-binding checks run in the backend suite because the Passkey private key cannot be exported." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonNegativeTests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Negative Tests" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Evidence export" />

                <TextView
                    android:id="@+id/textEvidenceStatus"
                    style="@style/BodyText"
                    android:text="NOT TESTED\nThe report contains only results stored by the backend." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonExportJson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export JSON Report" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonExportPdf"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export PDF Report" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Activity log" />

                <TextView
                    android:id="@+id/textLog"
                    style="@style/BodyText"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
