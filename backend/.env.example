# Bare hostname. It must match the app's rpHost and the public HTTPS certificate.
RP_ID=your-host.example.com
ORIGIN=https://your-host.example.com
RP_NAME=DT610 Auth Verification
# Long random lab secret. The handset sends it as X-Admin-Token.
ADMIN_TOKEN=replace-with-a-long-random-token
